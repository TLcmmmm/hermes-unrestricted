# ── Telegram Bridge 配置（部署时填写）────────────────────────
# 从 https://t.me/BotFather 创建 bot 获取 token
TELEGRAM_BOT_TOKEN=你的_bot_token

# 模型供应商：支持任意 OpenAI 兼容接口
# 通过 config.yaml 的 custom_providers 声明供应商后，这里指定模型与供应商名
#（详见 README「模型供应商」章节）
HERMES_MODEL=你的_模型名
HERMES_PROVIDER=你的_供应商名

# 代理（国内网络访问 Telegram 必需；直连可用可留空）
TELEGRAM_PROXY=http://127.0.0.1:PORT   # 你的代理地址

# 回发长度上限（可选）
# BRIDGE_MAX_CHARS=12000