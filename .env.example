# ── 模型供应商（必填，三要素）───────────────────────────────
HERMES_BASE_URL=你的_接口地址_如_https://xxx/v1
HERMES_API_KEY=你的_apikey
HERMES_MODEL=你的_模型名

# ── Telegram（可选，不接 Telegram 可留空）──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=http://127.0.0.1:7890   # 国内访问 Telegram 需要代理

# ── 回发长度上限（可选）────────────────────────────────────
# BRIDGE_MAX_CHARS=12000