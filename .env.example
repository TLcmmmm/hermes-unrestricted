# ── Telegram Bridge 配置（部署时填写）────────────────────────
# 从 https://t.me/BotFather 创建 bot 获取 token
TELEGRAM_BOT_TOKEN=你的_bot_token

# 模型供应商选一个：
# 方案 A - opencode-go（deepseek-v4-flash）
OPENCODE_GO_API_KEY=你的_opencode_go_key
HERMES_MODEL=deepseek-v4-flash
HERMES_PROVIDER=opencode-go

# Option B - grok-4.6 (custom endpoint)
# GROK46_API_KEY=<your grok endpoint api key>
# HERMES_MODEL=grok-4.6
# HERMES_PROVIDER=grok46

# 代理（国内网络访问 Telegram 必需；直连可用可留空）
TELEGRAM_PROXY=http://127.0.0.1:PORT   # 你的代理地址

# 回发长度上限（可选）
# BRIDGE_MAX_CHARS=12000
